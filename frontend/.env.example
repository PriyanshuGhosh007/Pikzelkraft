# ============================================================
# Pikzelkraft Frontend Environment
# Copy to frontend/.env.local and fill in real values
# ============================================================

# Public API base URL consumed by the browser (via Next.js proxy /api)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Backend origin used by the Next.js dev proxy (next.config.mjs)
BACKEND_URL=http://localhost:4000

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string
