# ============================================================
# Pikzelkraft Frontend Environment (static export)
# Copy to frontend/.env.local only if you need overrides.
# No secrets are required — the site builds and deploys without
# any environment variables.
# ============================================================

# Optional: external form endpoint (e.g. FormSubmit.co or Web3Forms)
# that receives the contact form as JSON. If left empty, the form
# falls back to prefilled WhatsApp + email links.
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://formsubmit.co/ajax/hello@pikzelkraft.com

# Optional: override the canonical site URL used for SEO metadata.
# NEXT_PUBLIC_SITE_URL=https://pikzelkraft.com
