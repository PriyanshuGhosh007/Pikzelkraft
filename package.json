{
  "name": "pikzelkraft",
  "version": "0.1.0",
  "private": true,
  "description": "Pikzelkraft — Digital Marketing & IT Solutions website",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @pikzelkraft/frontend",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace @pikzelkraft/frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
